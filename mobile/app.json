{
  "expo": {
    "name": "Study For You",
    "slug": "study-for-you",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FDE4EE",
    "ios": {
      "bundleIdentifier": "com.toannq.studyforyou",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.toannq.studyforyou",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#FDE4EE",
          "imageWidth": 240,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Study For You dùng micro để thu âm giọng đọc của bạn và nghe lại."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Study For You dùng micro để chấm phát âm tiếng Trung, tiếng Anh.",
          "speechRecognitionPermission": "Study For You nhận dạng giọng nói để kiểm tra bạn phát âm đúng hay sai."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Study For You cần ảnh để bạn đổi ảnh đại diện.",
          "cameraPermission": false
        }
      ],
      "expo-asset"
    ],
    "scheme": "studyforyou",
    "experiments": {
      "typedRoutes": true
    }
  }
}
